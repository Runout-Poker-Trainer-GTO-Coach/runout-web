# Firebase (web app config from Firebase console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIRESTORE_USERS_COLLECTION=users
# VITE_FIRESTORE_QUESTIONS_COLLECTION=questions
# Remote config document (defaults: collection config, document id app)
# VITE_FIRESTORE_SETTINGS_COLLECTION=config
# VITE_FIRESTORE_SETTINGS_DOC_ID=app

# Admin panel login (embedded in the client bundle — internal/trusted use only).
#
# Full access (Users, Questions, Settings): username defaults to `runout` unless overridden.
# VITE_ADMIN_FULL_USERNAME=runout
# Prefer an explicit full-admin password (optional if you use legacy VITE_ADMIN_PASSWORD only):
# VITE_ADMIN_FULL_PASSWORD=
#
# Questions-only access (reported questions; no Users or Settings): username defaults to `admin`.
# VITE_ADMIN_REPORTS_USERNAME=admin
# VITE_ADMIN_REPORTS_PASSWORD=
#
# Legacy: single password, full access only — leave username empty or use the full username.
ADMIN_PASSWORD=
# VITE_ADMIN_PASSWORD=

# Optional: RevenueCat subscription column (secret in client is unsafe for production)
# VITE_REVENUECAT_SECRET_API_KEY=
# VITE_REVENUECAT_PROJECT_ID=
